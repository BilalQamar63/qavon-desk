// Prisma Schema for Qavon Desk
// Production PostgreSQL Configuration for Vercel, Neon, Supabase, or Railway

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SALES_REP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
}

enum DealStage {
  NEW_OPPORTUNITY
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  FOLLOW_UP
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  email               String            @unique
  passwordHash        String
  name                String
  role                UserRole          @default(SALES_REP)
  title               String?           @default("Sales Representative")
  avatar              String?
  invitationTokenHash String?           @unique
  invitationExpiresAt DateTime?
  memberships         WorkspaceMember[]
  leads               Lead[]            @relation("AssignedLeads")
  deals               Deal[]            @relation("AssignedDeals")
  companies           Company[]         @relation("OwnedCompanies")
  activities          Activity[]        @relation("AssignedActivities")
  auditLogs           AuditLog[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([email])
}

model Workspace {
  id         String            @id @default(uuid()) @db.Uuid
  name       String
  slug       String            @unique
  plan       String            @default("Professional")
  currency   String            @default("USD")
  timezone   String            @default("America/New_York")
  members    WorkspaceMember[]
  leads      Lead[]
  companies  Company[]
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  auditLogs  AuditLog[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([slug])
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        UserRole  @default(SALES_REP)
  joinedAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Lead {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
  fullName       String
  email          String
  phone          String?
  company        String
  jobTitle       String?
  source         String       @default("Website")
  status         LeadStatus   @default(NEW)
  estimatedValue Decimal      @default(0) @db.Decimal(12, 2)
  notes          String?      @db.Text
  assignedToId   String       @db.Uuid
  convertedToDealId String?   @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo User       @relation("AssignedLeads", fields: [assignedToId], references: [id])
  activities Activity[]

  @@index([workspaceId, status])
  @@index([workspaceId, assignedToId])
}

model Company {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  name        String
  industry    String
  website     String?
  email       String?
  phone       String?
  size        String     @default("10-50 employees")
  address     String?
  notes       String?    @db.Text
  ownerId     String     @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner      User       @relation("OwnedCompanies", fields: [ownerId], references: [id])
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  @@index([workspaceId, name])
  @@index([workspaceId, ownerId])
}

model Contact {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  firstName   String
  lastName    String
  email       String
  phone       String?
  jobTitle    String?
  notes       String?    @db.Text
  companyId   String     @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals      Deal[]
  activities Activity[]

  @@index([workspaceId, companyId])
  @@index([workspaceId, email])
}

model Deal {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @db.Uuid
  title             String
  companyId         String       @db.Uuid
  contactId         String?      @db.Uuid
  value             Decimal      @db.Decimal(12, 2)
  stage             DealStage    @default(NEW_OPPORTUNITY)
  probability       Int          @default(20)
  expectedCloseDate DateTime
  ownerId           String       @db.Uuid
  priority          DealPriority @default(MEDIUM)
  description       String?      @db.Text
  order             Int          @default(0)
  lastActivityAt    DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User       @relation("AssignedDeals", fields: [ownerId], references: [id])
  activities Activity[]

  @@index([workspaceId, stage])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, companyId])
}

model Activity {
  id           String       @id @default(uuid()) @db.Uuid
  workspaceId  String       @db.Uuid
  type         ActivityType @default(TASK)
  title        String
  description  String?      @db.Text
  completed    Boolean      @default(false)
  dueDate      DateTime
  assignedToId String       @db.Uuid
  leadId       String?      @db.Uuid
  contactId    String?      @db.Uuid
  dealId       String?      @db.Uuid
  companyId    String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo User      @relation("AssignedActivities", fields: [assignedToId], references: [id])
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, completed])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, dueDate])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  action      String
  entityType  String
  entityId    String
  details     String   @db.Text
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
